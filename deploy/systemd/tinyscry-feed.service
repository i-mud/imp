[Unit]
Description=TinyScry live GMCP feed (spool drain, normalize, publish)
After=network.target tinyscry-relay.service
Wants=tinyscry-relay.service

[Service]
Type=simple
ExecStart=%h/tinyscry/integrations/tinyfugue/.venv/bin/tinyscry-feed
ExecStopPost=/usr/bin/rm -f %h/.local/state/tinyscry/spool
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
