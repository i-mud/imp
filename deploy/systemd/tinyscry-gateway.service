[Unit]
Description=TinyScry authenticated remote gateway
After=network.target tinyscry-relay.service
Wants=tinyscry-relay.service

[Service]
Type=simple
EnvironmentFile=%h/.config/tinyscry/gateway.env
ExecStart=%h/tinyscry/services/relay/.venv/bin/tinyscry-gateway --host 127.0.0.1 --port 8788 --relay-url ws://127.0.0.1:8787
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
