# Dependencies
node_modules/
.venv/
venv/

# Build output
dist/
build/
target/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Tooling caches
.eslintcache
.vite/

# Local configuration and secrets.
# Imp never persists credentials; these patterns exist so a stray local
# file can never be committed by accident.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
known_hosts

# Private capture output. Raw GMCP, the live spool and diagnostic captures are
# unredacted MUD data; only the sanitized fixtures under
# integrations/tinyfugue/fixtures/ are tracked. gmcp.raw* also matches the
# diagnostics directory's rotated files (gmcp.raw.1, gmcp.raw.2, ...).
gmcp.raw*
spool
records*.jsonl

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Regenerable Tauri sidecar binaries
apps/desktop/src-tauri/binaries/

# Generated desktop Mudlet helper resources.
apps/desktop/src-tauri/resources/mudlet/*
!apps/desktop/src-tauri/resources/mudlet/.gitkeep
