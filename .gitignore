# Dependencies
node_modules/
.venv/
venv/

# Build output
dist/
build/
target/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Tooling caches
.eslintcache
.vite/

# Local configuration and secrets.
# TinyScry never persists credentials; these patterns exist so a stray local
# file can never be committed by accident.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
known_hosts

# Private capture output. Raw GMCP and its converted records are unredacted MUD
# data; only the sanitized fixtures under integrations/tinyfugue/fixtures/ are
# tracked.
gmcp.raw
records*.jsonl

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
