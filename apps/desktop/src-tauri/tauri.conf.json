{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Imp",
  "version": "0.2.7",
  "identifier": "dev.imud.imp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "hud",
        "title": "Imp",
        "width": 320,
        "height": 210,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "minimizable": false
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/imp-node"],
    "resources": {
      "binaries/imp-node-runtime/": "imp-node-runtime/",
      "resources/mudlet/": "mudlet/"
    }
  }
}
